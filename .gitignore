**/target/
**/build/
**/.gradle/
**/.mvn/
**/.classpath
**/.project
**/.settings/
**/.idea/
**/.vscode/
**/.DS_Store
**/out/
**/bin/
**/*.iml
**/logs/
**/*.log
**/.lombok/

# Maven specific
**/pom.xml.tag
**/pom.xml.releaseBackup
**/pom.xml.versionsBackup
**/release.properties

